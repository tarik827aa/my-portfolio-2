<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Md. Tarikul Islam | Portfolio, CV & Visual Archive</title>
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
  
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            display: ['Plus Jakarta Sans', 'sans-serif'],
          }
        }
      }
    }
  </script>

  <style>
    body {
      background-color: #06070B;
      color: #F8FAFC;
      overflow-x: hidden;
    }
    /* Glass Navbar */
    .glass-nav {
      background: rgba(10, 13, 22, 0.82);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.7);
    }
    /* Interactive Nav Link Hover Effect */
    .nav-link {
      position: relative;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      white-space: nowrap;
    }
    .nav-link::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 9999px;
      background: rgba(99, 102, 241, 0.18);
      border: 1px solid rgba(99, 102, 241, 0.45);
      box-shadow: 0 0 15px rgba(99, 102, 241, 0.25);
      opacity: 0;
      transform: scale(0.85);
      transition: all 0.25s ease;
      z-index: -1;
    }
    .nav-link:hover::before {
      opacity: 1;
      transform: scale(1);
    }
    .nav-link:hover {
      color: #FFFFFF;
      transform: translateY(-1px);
    }
    /* Smooth Bento Cards */
    .bento-card {
      background: linear-gradient(180deg, rgba(18, 22, 34, 0.78) 0%, rgba(10, 13, 20, 0.95) 100%);
      border: 1px solid rgba(255, 255, 255, 0.08);
      transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .bento-card:hover {
      transform: translateY(-5px);
      border-color: rgba(99, 102, 241, 0.45);
      box-shadow: 0 20px 40px -15px rgba(99, 102, 241, 0.22);
    }
    .album-item {
      transition: all 0.35s ease;
    }
  </style>
</head>
<body class="antialiased selection:bg-indigo-500 selection:text-white">

  <!-- FLOATING NAVBAR (ALWAYS VISIBLE ON BOTH SMALL & LARGE SCREENS) -->
  <header class="fixed top-3 inset-x-0 z-50 flex justify-center px-3">
    <nav class="glass-nav rounded-2xl sm:rounded-full px-3 sm:px-6 py-2.5 flex flex-wrap items-center justify-center gap-2 sm:gap-5 max-w-full">
      
      <!-- Brand Logo / Name -->
      <a href="#home" class="font-display font-extrabold text-white tracking-tight text-sm md:text-base flex items-center gap-2 pr-2 sm:border-r border-white/10">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
        Tarikul<span class="text-indigo-400">.</span>
      </a>

      <!-- Menu Items (Never hidden on small screens) -->
      <div class="flex items-center flex-wrap justify-center gap-1 sm:gap-2 text-xs md:text-sm text-slate-300 font-medium">
        <a href="#about" class="nav-link px-3 py-1.5 rounded-full">About</a>
        <a href="#cv" class="nav-link px-3 py-1.5 rounded-full">CV & Resume</a>
        <a href="#albums" class="nav-link px-3 py-1.5 rounded-full">Albums & Videos</a>
        <a href="#projects" class="nav-link px-3 py-1.5 rounded-full">Projects</a>
      </div>

      <!-- Call To Action Button -->
      <a href="#contact" class="bg-indigo-600 hover:bg-indigo-500 text-white text-xs md:text-sm font-semibold px-4 py-1.5 sm:py-2 rounded-full transition-all duration-300 shadow-lg shadow-indigo-500/25 hover:shadow-indigo-500/40 hover:scale-105">
        Let's Talk
      </a>
    </nav>
  </header>

  <!-- 1. TRUE FULL-WIDTH EDGE-TO-EDGE FACEBOOK COVER BANNER (NEVER CROPS SIDES) -->
  <section id="home" class="relative w-full pt-16 sm:pt-0">
    
    <!-- Edge-to-Edge Cover Photo Container -->
    <div class="relative w-full overflow-hidden bg-[#06070B]">
      <img 
        src="cover.jpg" 
        onerror="this.src='profile.jpg'; this.onerror=function(){this.src='https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=1920&q=80'};" 
        alt="Md. Tarikul Islam Cover Banner" 
        class="w-full h-auto max-h-[520px] object-contain sm:object-cover object-center mx-auto block"
      />
      <!-- Soft Bottom Fade so Cover Blends into the Page Smoothly -->
      <div class="absolute inset-x-0 bottom-0 h-16 sm:h-32 bg-gradient-to-t from-[#06070B] via-[#06070B]/60 to-transparent pointer-events-none"></div>
    </div>

    <!-- HERO TEXT & INTRO (Positioned cleanly below the cover so it never blocks your cover photo) -->
    <div class="relative z-20 max-w-5xl mx-auto px-5 pt-4 pb-12 text-center flex flex-col items-center">
      
      <!-- Top Live Badge Highlight -->
      <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-500/25 text-xs text-indigo-300 mb-5 shadow-lg">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        <span class="font-medium">Available for Brand & Textile Collaborations</span>
      </div>

      <!-- Signature Heading -->
      <h1 class="font-display text-3xl sm:text-5xl md:text-7xl font-black tracking-tight text-white leading-[1.12]">
        Hi, I'm <span class="bg-gradient-to-r from-indigo-400 via-purple-300 to-emerald-400 bg-clip-text text-transparent">Md. Tarikul Islam</span>
      </h1>

      <!-- Value Proposition with Key Highlights -->
      <p class="mt-5 text-slate-300 text-sm sm:text-lg md:text-xl max-w-3xl leading-relaxed">
        Bridging analytical precision in <span class="text-emerald-400 font-semibold underline decoration-emerald-500/50 decoration-2 underline-offset-4">Wet Process Engineering</span> with high-impact <span class="text-indigo-300 font-semibold underline decoration-indigo-500/50 decoration-2 underline-offset-4">Brand Identity, Video Production, and Creative Direction</span>.
      </p>

      <!-- Action Buttons -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3.5">
        <a href="#albums" class="px-6 py-3.5 rounded-xl bg-white text-slate-950 font-bold text-xs sm:text-sm hover:bg-slate-200 transition-all duration-300 flex items-center gap-2 shadow-xl hover:scale-105">
          <i data-lucide="play-circle" class="w-4 h-4 text-indigo-600"></i>
          Explore Work & Albums
        </a>
        <a href="cv.pdf" download class="px-6 py-3.5 rounded-xl bg-indigo-600/25 border border-indigo-400/40 text-indigo-200 font-semibold text-xs sm:text-sm hover:bg-indigo-600 hover:text-white transition-all duration-300 flex items-center gap-2 shadow-xl hover:scale-105">
          <i data-lucide="download" class="w-4 h-4"></i>
          Download Full CV
        </a>
        <a href="#contact" class="px-6 py-3.5 rounded-xl bento-card text-slate-200 font-medium text-xs sm:text-sm hover:text-white transition-all duration-300 flex items-center gap-2">
          <i data-lucide="mail" class="w-4 h-4 text-emerald-400"></i>
          Contact
        </a>
      </div>

    </div>
  </section>

  <!-- QUICK HIGHLIGHT STRIP (KEY POINTS WITH PROFESSIONAL COLORS) -->
  <section class="relative z-20 max-w-6xl mx-auto px-5 mb-12">
    <div class="bento-card rounded-2xl p-4 md:p-6 grid grid-cols-2 lg:grid-cols-4 gap-4 text-center divide-y lg:divide-y-0 lg:divide-x divide-white/10 shadow-2xl">
      <div class="p-2">
        <span class="block font-display font-extrabold text-lg md:text-2xl text-indigo-400">Undergraduate</span>
        <span class="text-xs text-slate-400 mt-1 block">Wet Process Eng. (BTEC)</span>
      </div>
      <div class="p-2">
        <span class="block font-display font-extrabold text-lg md:text-2xl text-emerald-400">Creative Affairs</span>
        <span class="text-xs text-slate-400 mt-1 block">Senior Exec @ Career Club BTEC</span>
      </div>
      <div class="p-2 pt-4 lg:pt-2">
        <span class="block font-display font-extrabold text-lg md:text-2xl text-purple-400">Campus Ambassador</span>
        <span class="text-xs text-slate-400 mt-1 block">Textile Engineers Association</span>
      </div>
      <div class="p-2 pt-4 lg:pt-2">
        <span class="block font-display font-extrabold text-lg md:text-2xl text-amber-400">Founder & Designer</span>
        <span class="text-xs text-slate-400 mt-1 block">Monsoon Brand Identity</span>
      </div>
    </div>
  </section>

  <!-- MAIN CONTAINER FOR CONTENT -->
  <main class="relative z-10 max-w-6xl mx-auto px-5 pb-24">

    <!-- 2. ABOUT BENTO GRID -->
    <section id="about" class="py-10">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <div class="md:col-span-2 bento-card rounded-3xl p-7 md:p-8 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-2 text-indigo-400 text-xs font-semibold uppercase tracking-wider mb-3">
              <i data-lucide="user-check" class="w-4 h-4"></i>
              Personal Narrative
            </div>
            <h2 class="font-display text-2xl md:text-3xl font-bold text-white mb-4">
              Engineering precision meets commercial visual design.
            </h2>
            <p class="text-slate-400 leading-relaxed text-sm md:text-base">
              I am an undergraduate student specializing in <strong class="text-emerald-300 font-semibold">Wet Process Engineering</strong> at <strong class="text-white font-semibold">Barishal Textile Engineering College (BTEC)</strong>. Alongside technical laboratory research, I lead graphic communications, design end-to-end commercial brand packaging, and edit video content with high visual retention.
            </p>
          </div>
          <div class="mt-6 pt-6 border-t border-white/5 grid grid-cols-2 sm:grid-cols-3 gap-4 text-sm">
            <div>
              <span class="block text-slate-500 text-xs">Full Name</span>
              <span class="font-semibold text-white">Md. Tarikul Islam</span>
            </div>
            <div>
              <span class="block text-slate-500 text-xs">Academic Base</span>
              <span class="font-semibold text-indigo-300">BTEC, Barishal</span>
            </div>
            <div>
              <span class="block text-slate-500 text-xs">Core Focus</span>
              <span class="font-semibold text-emerald-400">Branding, Video & Textiles</span>
            </div>
          </div>
        </div>

        <div class="bento-card rounded-3xl p-7 md:p-8 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-2 text-emerald-400 text-xs font-semibold uppercase tracking-wider mb-3">
              <i data-lucide="sparkles" class="w-4 h-4"></i>
              Signature Strengths
            </div>
            <h3 class="font-display text-xl font-bold text-white mb-4">What Sets Me Apart</h3>
            <ul class="space-y-3.5 text-sm text-slate-300">
              <li class="flex items-center gap-3">
                <span class="w-2 h-2 rounded-full bg-emerald-400 shrink-0"></span>
                <span>Brand Identity & Packaging Design</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-2 h-2 rounded-full bg-indigo-400 shrink-0"></span>
                <span>Final Cut Pro Video Production</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-2 h-2 rounded-full bg-purple-400 shrink-0"></span>
                <span>Campaign Strategy & Copywriting</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-2 h-2 rounded-full bg-amber-400 shrink-0"></span>
                <span>Textile Wet Processing & Tech Docs</span>
              </li>
            </ul>
          </div>
          <div class="mt-6 pt-4 border-t border-white/5 flex items-center justify-between text-xs text-slate-400">
            <span>Bangladesh</span>
            <span class="text-emerald-400 font-semibold">● Open to Projects</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. INTERACTIVE PHOTO & VIDEO ALBUMS -->
    <section id="albums" class="py-12">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
        <div>
          <span class="text-indigo-400 text-xs font-semibold uppercase tracking-wider">Visual Gallery</span>
          <h2 class="font-display text-2xl md:text-3xl font-bold text-white mt-1">Curated Albums & Video Reels</h2>
          <p class="text-slate-400 text-sm mt-1">Switch categories to explore edited videos, personal memories, and professional design assets.</p>
        </div>

        <!-- Filter Buttons -->
        <div class="flex flex-wrap gap-2 bg-white/5 p-1.5 rounded-2xl border border-white/10 self-start">
          <button onclick="filterAlbum('all')" id="tab-all" class="album-tab px-4 py-2 rounded-xl text-xs font-semibold bg-indigo-600 text-white transition">
            All Media
          </button>
          <button onclick="filterAlbum('videos')" id="tab-videos" class="album-tab px-4 py-2 rounded-xl text-xs font-semibold text-slate-300 hover:text-white transition flex items-center gap-1.5">
            <i data-lucide="video" class="w-3.5 h-3.5 text-rose-400"></i> My Videos
          </button>
          <button onclick="filterAlbum('personal')" id="tab-personal" class="album-tab px-4 py-2 rounded-xl text-xs font-semibold text-slate-300 hover:text-white transition flex items-center gap-1.5">
            <i data-lucide="camera" class="w-3.5 h-3.5 text-emerald-400"></i> Personal Photos
          </button>
          <button onclick="filterAlbum('professional')" id="tab-professional" class="album-tab px-4 py-2 rounded-xl text-xs font-semibold text-slate-300 hover:text-white transition flex items-center gap-1.5">
            <i data-lucide="briefcase" class="w-3.5 h-3.5 text-indigo-400"></i> Professional Work
          </button>
        </div>
      </div>

      <!-- Gallery Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

        <!-- VIDEO ITEM 1 -->
        <div class="album-item bento-card rounded-3xl overflow-hidden flex flex-col justify-between" data-category="videos">
          <div class="relative aspect-video bg-slate-900">
            <video controls class="w-full h-full object-cover" poster="https://images.unsplash.com/photo-1574717024653-61fd2cf4d44d?auto=format&fit=crop&w=600&q=80">
              <source src="video1.mp4" type="video/mp4">
            </video>
            <span class="absolute top-3 left-3 px-2.5 py-1 rounded-full bg-rose-500/90 text-white text-[11px] font-semibold flex items-center gap-1 shadow-lg">
              <i data-lucide="film" class="w-3 h-3"></i> Product Reel
            </span>
          </div>
          <div class="p-5">
            <h3 class="font-display font-bold text-white text-base">Commercial Product Reel — Monsoon</h3>
            <p class="text-slate-400 text-xs mt-1">Edited in Final Cut Pro with custom audio mastering and motion design.</p>
          </div>
        </div>

        <!-- VIDEO ITEM 2 -->
        <div class="album-item bento-card rounded-3xl overflow-hidden flex flex-col justify-between" data-category="videos">
          <div class="relative aspect-video bg-slate-900">
            <video controls class="w-full h-full object-cover" poster="https://images.unsplash.com/photo-1492691527719-9d1e07e534b4?auto=format&fit=crop&w=600&q=80">
              <source src="video2.mp4" type="video/mp4">
            </video>
            <span class="absolute top-3 left-3 px-2.5 py-1 rounded-full bg-rose-500/90 text-white text-[11px] font-semibold flex items-center gap-1 shadow-lg">
              <i data-lucide="film" class="w-3 h-3"></i> Event Promo
            </span>
          </div>
          <div class="p-5">
            <h3 class="font-display font-bold text-white text-base">Campus Event Promotional Story</h3>
            <p class="text-slate-400 text-xs mt-1">High-tempo event teaser created for campus seminars and competitions.</p>
          </div>
        </div>

        <!-- PROFESSIONAL ITEM 1 -->
        <div class="album-item bento-card rounded-3xl overflow-hidden flex flex-col justify-between group cursor-pointer" data-category="professional" onclick="openLightbox(this.querySelector('img').src, 'Monsoon Brand Identity & Packaging')">
          <div class="relative h-56 overflow-hidden bg-slate-900">
            <img src="work1.jpg" onerror="this.src='https://images.unsplash.com/photo-1634942537034-2531766767d1?auto=format&fit=crop&w=600&q=80'" alt="Monsoon Branding" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
            <span class="absolute top-3 left-3 px-3 py-1 rounded-full bg-indigo-600/90 text-white text-[11px] font-semibold shadow-lg">
              Branding & Print
            </span>
          </div>
          <div class="p-5">
            <h3 class="font-display font-bold text-white text-base">Monsoon Brand & Label Artwork</h3>
            <p class="text-slate-400 text-xs mt-1">Identity system, roll-up banners, and Monsoon Honey Nuts jar labels.</p>
          </div>
        </div>

        <!-- PROFESSIONAL ITEM 2 -->
        <div class="album-item bento-card rounded-3xl overflow-hidden flex flex-col justify-between group cursor-pointer" data-category="professional" onclick="openLightbox(this.querySelector('img').src, 'Career Club BTEC Campaign Assets')">
          <div class="relative h-56 overflow-hidden bg-slate-900">
            <img src="work2.jpg" onerror="this.src='https://images.unsplash.com/photo-1558655146-d09347e92766?auto=format&fit=crop&w=600&q=80'" alt="Campaign Design" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
            <span class="absolute top-3 left-3 px-3 py-1 rounded-full bg-indigo-600/90 text-white text-[11px] font-semibold shadow-lg">
              Campaigns
            </span>
          </div>
          <div class="p-5">
            <h3 class="font-display font-bold text-white text-base">Event Posters & Key Visuals</h3>
            <p class="text-slate-400 text-xs mt-1">Visual campaign design for Mastering LinkedIn & Textile Blitz.</p>
          </div>
        </div>

        <!-- PERSONAL PHOTO 1 -->
        <div class="album-item bento-card rounded-3xl overflow-hidden flex flex-col justify-between group cursor-pointer" data-category="personal" onclick="openLightbox(this.querySelector('img').src, 'Campus Life & Moments')">
          <div class="relative h-56 overflow-hidden bg-slate-900">
            <img src="personal1.jpg" onerror="this.src='https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=600&q=80'" alt="Personal Moment" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
            <span class="absolute top-3 left-3 px-3 py-1 rounded-full bg-emerald-600/90 text-white text-[11px] font-semibold shadow-lg">
              Personal Memories
            </span>
          </div>
          <div class="p-5">
            <h3 class="font-display font-bold text-white text-base">Campus & Seminar Highlights</h3>
            <p class="text-slate-400 text-xs mt-1">Snapshots from textile engineering seminars and campus activities.</p>
          </div>
        </div>

        <!-- PERSONAL PHOTO 2 -->
        <div class="album-item bento-card rounded-3xl overflow-hidden flex flex-col justify-between group cursor-pointer" data-category="personal" onclick="openLightbox(this.querySelector('img').src, 'Travel & Life Captures')">
          <div class="relative h-56 overflow-hidden bg-slate-900">
            <img src="personal2.jpg" onerror="this.src='https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=600&q=80'" alt="Travel Moment" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
            <span class="absolute top-3 left-3 px-3 py-1 rounded-full bg-emerald-600/90 text-white text-[11px] font-semibold shadow-lg">
              Travel & Life
            </span>
          </div>
          <div class="p-5">
            <h3 class="font-display font-bold text-white text-base">Journeys & Daily Moments</h3>
            <p class="text-slate-400 text-xs mt-1">Candid captures, road trips, and everyday inspiration.</p>
          </div>
        </div>

      </div>
    </section>

    <!-- 4. COMPLETE CV & RESUME (EDUCATION, LEADERSHIP, SKILLS) -->
    <section id="cv" class="py-12">
      <div class="mb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <span class="text-indigo-400 text-xs font-semibold uppercase tracking-wider">Curriculum Vitae</span>
          <h2 class="font-display text-2xl md:text-3xl font-bold text-white mt-1">Professional & Academic Records</h2>
        </div>
        <a href="cv.pdf" download class="inline-flex items-center gap-2 text-xs font-semibold text-indigo-400 hover:text-indigo-300">
          <i data-lucide="file-text" class="w-4 h-4"></i> Download Full Resume (PDF)
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        
        <!-- Left: Leadership Roles -->
        <div class="space-y-4">
          <h3 class="font-display font-bold text-lg text-white flex items-center gap-2 mb-3">
            <i data-lucide="award" class="w-5 h-5 text-indigo-400"></i> Leadership & Organizational Impact
          </h3>

          <div class="bento-card rounded-2xl p-6">
            <div class="flex items-center justify-between text-xs text-indigo-400 font-semibold mb-1">
              <span>Career Club BTEC</span>
              <span class="px-2.5 py-0.5 rounded-full bg-indigo-500/15 border border-indigo-500/30">Active Role</span>
            </div>
            <h4 class="font-display font-bold text-white text-base">Senior Executive — Creative Affairs Wing</h4>
            <p class="text-slate-400 text-xs mt-2 leading-relaxed">
              Spearheading promotional branding, poster design, video trailers, and student registration funnels for flagship campus events including "Textile Blitz" and "Mastering LinkedIn".
            </p>
          </div>

          <div class="bento-card rounded-2xl p-6">
            <div class="flex items-center justify-between text-xs text-emerald-400 font-semibold mb-1">
              <span>Textile Engineers Association (TEA)</span>
              <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/15 border border-emerald-500/30">National Body</span>
            </div>
            <h4 class="font-display font-bold text-white text-base">Campus Ambassador</h4>
            <p class="text-slate-400 text-xs mt-2 leading-relaxed">
              Serving as the institutional liaison connecting BTEC students with national textile industry seminars, workshops, and nationwide networking sessions.
            </p>
          </div>

          <div class="bento-card rounded-2xl p-6">
            <div class="flex items-center justify-between text-xs text-amber-400 font-semibold mb-1">
              <span>Textile Focus — INSPIRATION</span>
              <span class="px-2.5 py-0.5 rounded-full bg-amber-500/15 border border-amber-500/30">Volunteering</span>
            </div>
